{
  "name": "mcp-repo-search-server",
  "version": "1.0.0",
  "description": "MCP server for multi-repository code search and context extraction",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-repo-search": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "code-search",
    "repository",
    "ast"
  ],
  "author": "Yohann Hommet",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/YohannHommet/mcp-repo-search-server.git"
  },
  "bugs": {
    "url": "https://github.com/YohannHommet/mcp-repo-search-server/issues"
  },
  "homepage": "https://github.com/YohannHommet/mcp-repo-search-server#readme",
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@vscode/ripgrep": "^1.17.0",
    "async-mutex": "^0.5.0",
    "fast-glob": "^3.3.3",
    "lru-cache": "^11.2.4",
    "simple-git": "^3.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
