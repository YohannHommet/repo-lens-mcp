{
  "name": "repo-lens-mcp",
  "type": "module",
  "version": "0.3.0",
  "description": "MCP server for multi-repository AST-based symbol search and API route discovery",
  "author": "Yohann Hommet <yohann.hommet@outlook.fr>",
  "license": "AGPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/YohannHommet"
  },
  "homepage": "https://github.com/YohannHommet/repo-lens-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YohannHommet/repo-lens-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YohannHommet/repo-lens-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "code-search",
    "multi-repository",
    "cross-repo",
    "monorepo",
    "microservices",
    "ast",
    "ast-grep",
    "repo-lens-mcp",
    "developer-tools",
    "llm",
    "anthropic",
    "model-context-protocol",
    "code-analysis",
    "symbol-search",
    "api-routes"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "repo-lens-mcp": "dist/index.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix",
    "typecheck": "oxlint --type-check",
    "ci": "npm run test:coverage && npm run typecheck && npm run lint",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:multi": "tsx scripts/benchmark-multi.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "async-mutex": "^0.5.0",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.0",
    "simple-git": "^3.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "oxlint": "^1.42.0",
    "tsdown": "^0.20.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
