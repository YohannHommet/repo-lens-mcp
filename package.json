{
  "name": "repo-lens-mcp",
  "type": "module",
  "version": "0.1.2",
  "description": "MCP server for intelligent repository search and code analysis",
  "author": "Yohann Hommet <yohann.hommet@outlook.fr>",
  "license": "AGPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/YohannHommet"
  },
  "homepage": "https://github.com/YohannHommet/repo-lens-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YohannHommet/repo-lens-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YohannHommet/repo-lens-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "code-search",
    "repository",
    "ast",
    "ast-grep",
    "ripgrep",
    "repo-lens-mcp",
    "developer-tools",
    "llm",
    "openai",
    "anthropic",
    "model-context-protocol",
    "code-analysis",
    "symbol-search"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "repo-lens-mcp": "dist/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "ci": "npm run test:coverage && npm run typecheck && npm run lint",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@vscode/ripgrep": "^1.17.0",
    "async-mutex": "^0.5.0",
    "fast-glob": "^3.3.3",
    "simple-git": "^3.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
